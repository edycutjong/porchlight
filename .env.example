# Copy to .env (gitignored). Without a key, Porchlight runs in MOCK mode so the full
# flow is buildable and demoable offline; real mode swaps in with zero code change.
#
# Get these from the Minds Builder console (build.hellominds.ai):
#   1. Create a Mind at hellominds.ai
#   2. Author the "Porchlight" Skill by describing it to the Mind (natural language)
#   3. Create a Builder API key; paste it below (shown only once)
MINDS_BUILDER_API_KEY=
MIND_ID=

# Force mock mode even if a key is present:
# PORCHLIGHT_MOCK=1

PORT=5173
