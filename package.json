{
  "name": "porchlight",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "description": "An exit-interview Mind that remembers why each member left and autonomously wins them back when their reason is actually fixed.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike": "tsx src/spike.ts",
    "seed": "tsx src/seed.ts",
    "demo": "tsx src/demo.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:demo": "npm run seed && npm start",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high --omit=dev",
    "ci": "npm run audit && npm run typecheck && npm run test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@animocabrands/minds-client-lib": "^0.1.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
