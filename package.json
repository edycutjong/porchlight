{
  "name": "porchlight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An exit-interview Mind that remembers why each member left and autonomously wins them back when their reason is actually fixed.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike": "tsx src/spike.ts",
    "seed": "tsx src/seed.ts",
    "demo": "tsx src/demo.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:demo": "npm run seed && npm start",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run audit && npm run typecheck && npm run test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@animocabrands/minds-client-lib": "^0.1.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
